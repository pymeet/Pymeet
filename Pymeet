<script>
/* ============ CARRUSEL ============ */
const track = document.getElementById('track');
const slides = document.querySelectorAll('.slide');
const dotsBox = document.getElementById('dots');
let current = 0, timer = null;

slides.forEach((_, i) => {
  const d = document.createElement('button');
  d.className = 'dot' + (i === 0 ? ' active' : '');
  d.setAttribute('aria-label', 'Diapositiva ' + (i + 1));
  d.onclick = () => { goTo(i); restart(); };
  dotsBox.appendChild(d);
});
const dots = document.querySelectorAll('.dot');

function goTo(i){
  current = (i + slides.length) % slides.length;
  track.style.transform = `translateX(-${current * 100}%)`;
  dots.forEach((d, k) => d.classList.toggle('active', k === current));
}
function moveSlide(n){ goTo(current + n); restart(); }
function restart(){
  clearInterval(timer);
  timer = setInterval(() => goTo(current + 1), 5000);
}
restart();
document.getElementById('carousel').addEventListener('mouseenter', () => clearInterval(timer));
document.getElementById('carousel').addEventListener('mouseleave', restart);

/* táctil */
let touchX = null;
track.addEventListener('touchstart', e => touchX = e.touches[0].clientX, {passive:true});
track.addEventListener('touchend', e => {
  if(touchX === null) return;
  const dx = e.changedTouches[0].clientX - touchX;
  if(Math.abs(dx) > 50) moveSlide(dx < 0 ? 1 : -1);
  touchX = null;
}, {passive:true});

function scrollToCategory(){
  document.getElementById('publicaciones').scrollIntoView({behavior:'smooth'});
}

/* ============ MODAL ============ */
const overlay = document.getElementById('modalOverlay');
let selectedRole = null;

function openModal(tab){
  overlay.classList.add('open');
  document.body.style.overflow = 'hidden';
  switchTab(tab);
}
function closeModal(){
  overlay.classList.remove('open');
  document.body.style.overflow = '';
}
function switchTab(tab){
  document.getElementById('tabBtnLogin').classList.toggle('active', tab === 'login');
  document.getElementById('tabBtnRegister').classList.toggle('active', tab === 'register');
  document.getElementById('pane-login').classList.toggle('active', tab === 'login');
  document.getElementById('pane-register').classList.toggle('active', tab === 'register');
}
function selectRole(r){
  selectedRole = r;
  document.getElementById('roleComprador').classList.toggle('selected', r === 'comprador');
  document.getElementById('roleVendedor').classList.toggle('selected', r === 'vendedor');
}
overlay.addEventListener('click', e => { if(e.target === overlay) closeModal(); });
document.addEventListener('keydown', e => { if(e.key === 'Escape') closeModal(); });

/* CUIT con guiones automáticos */
document.getElementById('regCuit').addEventListener('input', e => {
  let v = e.target.value.replace(/\D/g, '').slice(0, 11);
  if(v.length > 8) v = v.slice(0,2) + '-' + v.slice(2,10) + '-' + v.slice(10);
  else if(v.length > 2) v = v.slice(0,2) + '-' + v.slice(2);
  e.target.value = v;
});

function registerSubmit(e){
  e.preventDefault();
  const msg = document.getElementById('regMsg');
  const fields = ['regRazon','regCuit','regEmail','regPass','regArca'];
  let ok = true;
  fields.forEach(id => {
    const el = document.getElementById(id);
    const valid = el.tagName === 'SELECT' ? !!el.value : el.checkValidity() && el.value.trim() !== '';
    el.classList.toggle('error', !valid);
    if(!valid) ok = false;
  });
  const terms = document.getElementById('regTerms').checked;
  if(!selectedRole || !ok || !terms){
    msg.style.display = 'block';
    msg.textContent = !selectedRole
      ? 'Elegí tu perfil: comprador o vendedor.'
      : (!terms ? 'Tenés que aceptar los términos y condiciones.' : 'Revisá los datos marcados en rojo.');
    return;
  }
  msg.style.display = 'none';
  closeModal();
  showToast('¡Cuenta ' + (selectedRole === 'comprador' ? 'de comprador' : 'de vendedor') + ' creada con éxito! Revisá tu email para confirmar el registro.');
  document.querySelector('.account-btn .txt').innerHTML = 'Mi cuenta<b>' + document.getElementById('regRazon').value.split(' ')[0] + '</b>';
}

function loginSubmit(e){
  e.preventDefault();
  closeModal();
  showToast('¡Bienvenido de nuevo! Sesión iniciada correctamente.');
  document.querySelector('.account-btn .txt').innerHTML = 'Mi cuenta<b>' + document.getElementById('loginEmail').value.split('@')[0] + '</b>';
}

/* ============ TOAST ============ */
let toastTimer;
function showToast(text){
  const t = document.getElementById('toast');
  document.getElementById('toastText').textContent = text;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 4200);
}

/* ============ BUSCADOR EN VIVO ============ */
const searchInput = document.getElementById('searchInput');
searchInput.addEventListener('input', () => {
  const q = searchInput.value.trim().toLowerCase();
  const cards = document.querySelectorAll('#productGrid .card');
  let visible = 0;
  cards.forEach(c => {
    const match = c.textContent.toLowerCase().includes(q);
    c.style.display = match ? '' : 'none';
    if(match) visible++;
  });
  document.getElementById('noResults').style.display = visible === 0 && q ? 'block' : 'none';
  document.getElementById('noResultsQuery').textContent = searchInput.value;
});
document.querySelector('.search-bar button').addEventListener('click', () => {
  if(searchInput.value.trim()){
    document.getElementById('publicaciones').scrollIntoView({behavior:'smooth'});
  }
});
</script>
